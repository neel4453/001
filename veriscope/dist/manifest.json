{
  "manifest_version": 3,
  "name": "VeriScope — evidence-first fact-checking",
  "short_name": "VeriScope",
  "version": "1.0.0",
  "description": "Free, privacy-first claim verification: extract claims, gather key-free public evidence, compare sources, explain verdicts, and admit uncertainty. No paid APIs, no tracking, strict offline mode.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VeriScope — verify a claim",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "optional_permissions": [],
  "optional_host_permissions": [
    "https://api.openalex.org/*",
    "https://api.crossref.org/*",
    "https://en.wikipedia.org/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://www.ebi.ac.uk/*",
    "https://archive.org/*",
    "https://api.gdeltproject.org/*",
    "https://restcountries.com/*",
    "https://api.semanticscholar.org/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:8756/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'"
  },
  "minimum_chrome_version": "120",
  "incognito": "spanning"
}
