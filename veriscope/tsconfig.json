{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "chrome",
      "vite/client",
      "node"
    ],
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "vite.sw.config.ts",
    "vitest.setup.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts"
  ]
}